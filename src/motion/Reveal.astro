---
// A heading that reveals line by line as it scrolls into view (reveal.js):
//
//   <Reveal as="h2" enabled={section.motion}>How it works</Reveal>
//
// Its still is the heading as written, which is what shows on the first screen, without scripts,
// under reduced motion, while motion is paused and where `enabled` (the editor's on/off) is off.
// It plays once and needs no MotionToggle. Any other attribute goes on the element.

import './motion.css';

interface Props {
  /** The element to render, `h2` by default. */
  as?: string;
  /** The editor's on/off: off, the heading stays as written. */
  enabled?: boolean;
  class?: string;
  [attribute: string]: unknown;
}

const { as: Element = 'h2', enabled = true, class: className, ...attributes } = Astro.props;
---

<Element {...attributes} class:list={['dc-motion', className]} data-motion={enabled ? 'reveal' : undefined}><slot /></Element>

<script>
  import { register } from './runtime.js';

  register({ reveal: () => import('./reveal.js') });
</script>
