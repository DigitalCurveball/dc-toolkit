---
// Grain, dither and halftone on photos (print.js, print.css), around the photo:
//
//   <Print look="halftone" colors={['#D11F1F', '#FFF1F1']} enabled={about.motion}><Image src={photo.src} alt={photo.alt} /></Print>
//   <Print look="grain" as="section" moving>…a section's content…</Print>
//
// The markup it writes, the same in a concept, which links motion/print.css beside motion.css:
//
//   <div class="dc-motion dc-print dc-print--halftone" data-motion="print" style="--dc-print-dark: #D11F1F; --dc-print-light: #FFF1F1">
//     <img …>                                  the photo, which screen readers read
//     <span class="dc-print-look" aria-hidden="true">
//       <span class="dc-print-tone"><img …><span class="dc-print-blank"></span><span class="dc-print-screen"></span></span>
//       <span class="dc-print-light"></span><span class="dc-print-dark"></span>
//     </span>
//   </div>
//
// The look is drawn from a copy of the photo, so the slot is rendered twice, and the copy fills the
// element as `object-fit: cover` does: the photo must fill the element too (set `position` for an
// `object-position` other than the centre). Grain's look is the one empty span, over everything in
// the element, so it can go on a section as well as a photo; still grain runs no script. Dither
// and halftone are for photos that read at a glance, never one with words in it, and words go on
// a solid panel, not over the dots. Dither, halftone and still grain need no MotionToggle; moving
// grain loops, so the page needs one. `enabled` is the editor's on/off: off, the photo is as it is.
// Any other attribute goes on the element.

import './motion.css';
import './print.css';

interface Props {
  /** The look: 'grain', 'dither' or 'halftone'. */
  look: 'grain' | 'dither' | 'halftone';
  /** Dither's and halftone's two colours, either way round: the darker draws the photo's darks. Black and white by default. */
  colors?: [string, string];
  /** The dither's pixel or the halftone's dot spacing, in CSS pixels: 2 and 6 by default. */
  size?: number;
  /** How much the photo is lightened before it is printed: 1.1 by default; more for a dark photo. */
  tone?: number;
  /** The photo's object-position, if it isn't centred. */
  position?: string;
  /** The grain's strength, from 0 to 1: 0.3 by default. */
  grain?: number;
  /** Grain that moves like film, about ten times a second: it loops, so the page needs a MotionToggle. */
  moving?: boolean;
  /** The editor's on/off: off, the photo is as it is and nothing runs. */
  enabled?: boolean;
  /** The element to render, `div` by default. */
  as?: string;
  class?: string;
  style?: string;
  [attribute: string]: unknown;
}

const { look, colors = ['#111111', '#ffffff'], size, tone, position, grain, moving = false, enabled = true, as: Element = 'div', class: className, style, ...attributes } = Astro.props;
const content = await Astro.slots.render('default');

/** A colour's red, green and blue, from #rgb or #rrggbb, or null. */
const channels = (colour: string) => {
  const hex = colour.trim().replace(/^#/, '');
  if (!/^([0-9a-f]{3}|[0-9a-f]{6})$/i.test(hex)) return null;
  const full = hex.length === 3 ? [...hex].map((c) => c + c).join('') : hex;
  return [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16));
};
// The darker draws the darks. Blend modes print the two exactly only where it is no lighter than
// the other in any of red, green and blue (print.css); otherwise the colours mix where tones meet.
let [dark, light] = colors;
const [a, b] = colors.map(channels);
if (a && b) {
  const luminance = ([r, g, bl]: number[]) => 0.2126 * r + 0.7152 * g + 0.0722 * bl;
  if (luminance(a) > luminance(b)) [dark, light] = [light, dark];
  const [d, l] = luminance(a) > luminance(b) ? [b, a] : [a, b];
  if (look !== 'grain' && d.some((c, i) => c > l[i])) console.warn(`dc-toolkit Print: ${dark} is lighter than ${light} in red, green or blue, so the two mix where the photo's tones meet; pick a pair where the darker is darker in all three`);
}

const custom = [
  look !== 'grain' && `--dc-print-dark: ${dark}; --dc-print-light: ${light}`,
  size !== undefined && `--dc-print-size: ${size}px`,
  tone !== undefined && `--dc-print-tone: ${tone}`,
  position && `--dc-print-position: ${position}`,
  grain !== undefined && `--dc-print-grain: ${grain}`,
  style,
].filter(Boolean).join('; ');
const effect = look === 'grain' ? (moving ? 'grain' : undefined) : 'print';
---

{enabled ? (
  <Element {...attributes} class:list={['dc-motion', 'dc-print', `dc-print--${look}`, className]} style={custom || undefined} data-motion={effect}>
    <Fragment set:html={content} />
    <span class="dc-print-look" aria-hidden="true">
      {look !== 'grain' && (
        <>
          <span class="dc-print-tone"><Fragment set:html={content} /><span class="dc-print-blank"></span><span class="dc-print-screen"></span></span>
          <span class="dc-print-light"></span><span class="dc-print-dark"></span>
        </>
      )}
    </span>
  </Element>
) : (
  <Element {...attributes} class={className} style={style}><Fragment set:html={content} /></Element>
)}

<script>
  import { register } from './runtime.js';

  register({ print: () => import('./print.js'), grain: () => import('./print.js').then((module) => module.grain) });
</script>
